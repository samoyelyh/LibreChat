{
  "name": "@woda/ai-quota-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mapping:upsert": "tsx src/cli/upsert-mapping.ts",
    "mapping:status": "tsx src/cli/mapping-status.ts",
    "accounts:provision": "tsx src/cli/provision-users.ts",
    "verify:live": "tsx src/cli/verify-live.ts"
  },
  "dependencies": {
    "fastify": "5.10.0",
    "ioredis": "5.11.1",
    "jose": "6.2.4",
    "mongodb": "7.5.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
